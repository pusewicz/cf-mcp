module CF
  module MCP
    class CLI
      # Commands that run a documentation tool.
      TOOL_COMMANDS: Array[String]

      type options = {
        port: Integer?,
        host: String,
        root: String?,
        download: bool,
        help: bool,
        version: bool
      }

      @args: Array[String]
      @options: options
      @option_parser: OptionParser

      def initialize: (Array[String] args) -> void

      # Returns the process exit status.
      def run: () -> Integer

      private

      def build_option_parser: () -> OptionParser

      def print_version: () -> Integer

      def print_usage: () -> Integer

      def fail_with: (String message) -> Integer

      def run_stdio: () -> Integer

      def run_http: () -> Integer

      def run_index: () -> Integer

      def run_tool: (String name) -> Integer

      # What the user asked to index; nil leaves the choice to the cache.
      def index_source: () -> IndexCache::source?

      def missing_headers_message: (IndexBuilder builder) -> String
    end
  end
end
